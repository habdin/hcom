@*
   Index.razor - Main entry point for listing and managing Dummies2 module

   Features:
   - Interface toggling (Card/Table)
   - Searching functionality
   - Data loading from EF Core context
   - CRUD operations via a reusable Modal component.

   This file is responsible only for composing the UI.
   The implementation details are delegated to the corresponding
   partial class files.
*@

@page "/dummies2"
@using Microsoft.EntityFrameworkCore
@using blazor_hcom.Models.Dummy2

@namespace blazor_hcom.Components.Pages.Dummy2Pages

@* Page title that appears in the browser title bar. *@
<AppTitle Title="Dummy2 Index" /> 

@* Inserts Heading and Toolbar for the Dummy2 Index Page *@
<div class="d-flex justify-content-between align-items-stretch pt-5 ">
	<h2 class="display-5 mt-4 flex-grow-1">List of Dummies 2</h2>

	<Toolbar SearchString="@SearchHandler"
		 PageSize="@PageSize"
		 PageAmount="@PageAmountChangedHandler"
		 ViewToggled="@HandleToggleView"
		 OnAddNew="HandleCreate" />
</div>

@* Inserts a line just below the Heading and Toolbar *@
<hr class="mb-3">

@* Inserts the actual data component for the Dummy2 App *@
    <DataDisplay TEntity="Dummy2"
			    Items="@Items"
			    IsLoading="@IsLoading"
			    IsTable="@ViewAsTable"
			    OnUpdateRecord="HandleUpdate"
			    OnDeleteRecord="HandleDelete"
			    OnDetailsRecord="HandleRead"
    />

<div class="pb-5">
	@if(@_totalPages > 1)
	{
		<Paginator TotalPages="@_totalPages"
			CurrentPage="@_currentPage"
			TotalRecords="@_totalRecords"
			PageSize="@PageSize"
			PageLinkClicked="PagerLinkClickHandler"
		/>
	}
</div>

@* Inserts the Modals for the App. These are actually hidden and appear through events. *@
<Modal @ref="_dummy2ModalRef"
	   TEntity="Dummy2"
	   Fading="true"
	   Operation="@CrudOperation"
	   Title="@ModalTitle"
	   FormContent="@(MainForm(CrudOperation))"
	   BtnSubmitText="@ModalSubmitBtnText"
	   OnVisibilityChanged="@HandleModalVisibility"
	   Size="Modal<Dummy2>.ModalSize.ExtraLarge"
	   Backdrop="Modal<Dummy2>.ModalBackdrop.Static"
	   BackDropClick="() => HandleBackdropClick<Dummy2>(_dummy2ModalRef!)"
	   OnSubmit="(() => HandleSubmit(Item, CrudOperation))"
	   OnClose="() => ModalHideAsync<Dummy2>(_dummy2ModalRef!)"
/>

<Modal @ref="_categoryModalRef"
	    TEntity="Category"
	    Fading="true"
	    Operation="@CrudOperation"
	    Title="@ModalTitle"
	    FormContent="@(DepForm(CrudOperation))"
	    BtnSubmitText="@ModalSubmitBtnText"
	    OnVisibilityChanged="@HandleModalVisibility"
	    Size="Modal<Category>.ModalSize.ExtraLarge"
	    Backdrop="Modal<Category>.ModalBackdrop.Static"
	    BackDropClick="() => HandleBackdropClick<Category>(_categoryModalRef!)"
	    OnSubmit="(() => HandleSubmitCategory(CategoryItem, CrudOperation))"
	    OnClose="() => DepModalOnCloseHandler()"
/>

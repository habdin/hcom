@inherits LayoutComponentBase
@using System.Linq
@inject IMessageService NotifySrvs
@using blazor_hcom.Classes
@inject UiStateService UiStateSrvs


<HeadContent>
	<SectionOutlet SectionName="PageTitle" />
</HeadContent>


<div class="d-flex flex-column min-vh-100">
	<NavMenu NotificationToggle="ToggleNotificationPanel" />

	<div style="@(IsPanelVisible ? "display: block;" : "display: none;")">
		<NotificationPanel Messages="Messages" OnClearAll="()=>NotifySrvs.ClearAllMessages()" />
	</div>

	<div class="container flex-grow-1 @(UiStateSrvs.ModalOpen ? "modal-open" : null)"
		style="@(UiStateSrvs.ModalOpen ? "overflow: hidden;" : null)">
		<main>
			<article class="content">
				@Body
			</article>
		</main>
	</div>

	<footer class="bg-primary text-light p-3">
		<div class="container-fluid">
			<a href="" class="nav-link">HCOM</a>
		</div>
	</footer>
</div>

@code 
{
    @* Expose the latest message from the NotificationService *@
    private IReadOnlyList<AppMessage> Messages => NotifySrvs.Messages.Count == 0
	? Array.Empty<AppMessage>()
	: NotifySrvs.Messages.Reverse().ToList();

    private bool IsPanelVisible { get; set; } = false;
    private void ToggleNotificationPanel () {
	StateHasChanged();
	IsPanelVisible = !IsPanelVisible;
    }

    @* Subscribe to the NotificationService on Component Initialization *@
    protected override void OnInitialized()
    {
	NotifySrvs.OnMessageAdded += Notify;
	NotifySrvs.OnMessagesChanged += Notify;
	UiStateSrvs.OnChange += StateHasChanged;
    }

    @* Used method overloading to respond to MessageService eventcallbacks *@
    private async Task Notify(AppMessage message){
	IsPanelVisible = true;
	await InvokeAsync(StateHasChanged);
    } 

    private async Task Notify() {
	IsPanelVisible = true;
	await InvokeAsync(StateHasChanged);
    }
    
    @* Unsubscribe from NotificationService on component disposal
       (required to be public due to IDisposable) *@
    public void Dispose()
    {
	NotifySrvs.OnMessageAdded -= Notify;
	NotifySrvs.OnMessagesChanged -= Notify;
	UiStateSrvs.OnChange -= StateHasChanged;
    }
}

@* 
[HCOM-DESIGN NOTES]
Component: ModelCreateUpdateForm.razor

Purpose:
- Renders the editable fields for the Dummy entity.
- Handles validation display only (no CRUD logic, no modal control).

Parameters:
This Parameter will be the sole parameter to be changed for various create and update form.
- [Parameter] public Dummy? Dummy { get; set; }
    → Receives the entity instance for form binding.
      In 'create' mode, this is a new Dummy().
      In 'update' mode, this is an existing Dummy with values preloaded.
      Rationale: The form is model-agnostic; it simply binds what it receives.

- [Parameter] public string? Operation { get; set; }
   → Provides context (create/update/read/etc.) for conditional UI or validation behavior.     Important even though form does not perform CRUD itself.

SOC Enforcement:
- Form = View-only logic (fields + validation)
- Index = Controller logic (modal state, CRUD dispatch)
- Modal = Presentation wrapper (UI shell for forms), responsible for form submission.
*@


@using blazor_hcom.Models.Dummy2

@namespace blazor_hcom.Components.Pages.Dummy2Pages

@* Blazor components are preferred over html form tag elements *@
<EditForm EditContext="@EditContext">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert"/>
    <div class="mb-3">
	<label for="name" class="form-label">Name</label> 
	<InputText id="name" @bind-Value="Dummy2!.Name" class="form-control" aria-required="true"/>
	<ValidationMessage For="() => Dummy2.Name" class="text-danger" /> 
    </div>        
    <div class="mb-3">
	<label for="category" class="form-label">Category</label> 
	<div class="d-flex justify-content-between">	
	    <InputSelect id="category" @bind-Value="Dummy2!.CategoryId" class="form-control flex-grow-1 me-3">
		@foreach (var category in CategoryItems) 
		{
		    <option value="@category.Id">@category.Name</option>
		}
	    </InputSelect>
	    <button type="button" class="btn btn-primary" @onclick="HandleDepOnAddNew">
		<i class="fas fa-plus-square" title="Add new record"></i>
	    </button>	
	</div>	
	<ValidationMessage For="() => Dummy2.Category" class="text-danger" /> 
    </div>        
</EditForm>
@code 
{
    [Parameter] public Dummy2? Dummy2 { get; set; }
    [Parameter] public string? Operation { get; set; }
    [Parameter] public EditContext? EditContext { get; set; }
    // To be moved to DependentEntrySelectorCreator
    [Parameter] public IReadOnlyList<Category> CategoryItems { get; set; } = []; 
    [Parameter] public Func<Task>? DepOnAddNew { get; set; } = default!;
    private Task HandleDepOnAddNew() => DepOnAddNew!();
}

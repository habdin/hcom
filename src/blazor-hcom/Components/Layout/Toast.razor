@namespace blazor_hcom.Components.Layout

<div class="toast @(IsVisible ? "fade" : string.Empty)
		    @(IsShown ? "show": string.Empty)" id="@ToastId">
    <div class="toast-header">
	<ToastHeader
	    Level="@Message!.Level"
	    Message="@Message!.Text"
	    CreatedAt="Message!.CreatedAt"
	    CurrentTime="@CurrentTime" />
	<div class="btn-group ms-auto">
	    <button class="btn btn-sm"
		    @onclick="()=> MessageDeleted(Message.Id)"
		    title="Remove Message" >
		<i class="fas fa-trash"></i>
	    </button>
	    <button class="btn btn-sm" @onclick="Hide" title="Hide Message">
		<i class="fas fa-times"></i>
	    </button>
	</div>
    </div>	
	@*<div class="toast-body text-bg-@Message.Level.ToBootStrapColor()">@Message.Text</div>*@
</div>

@namespace blazor_hcom.Components.Layout

@* 
[HCOM-DESIGN Notes]
Paginator is responsible only for pagination UI and page-navigation events.
The parent component remains responsible for loading the corresponding data.

The component receives the current paging state through parameters:
    - TotalPages
    - CurrentPage
    - TotalRecords
    - PageSize

Navigation requests are propagated through PageLinkClicked.
GoToPage() provides a single entry point for all navigation operations and
ensures that a requested page remains within the valid page range.
*@

<div class="d-flex flex-column flex-md-row gap-5 align-items-center justify-content-center justify-content-md-between">

	@* 
	[HCOM-DESIGN Notes]
	Display the current record range rather than merely the current page.
	The range is calculated from CurrentPage and PageSize and is capped by
	TotalRecords so the final page does not report records beyond the dataset.
	*@
	<p class="text-center mt-3 mb-1">
		Showing @((CurrentPage - 1) * PageSize + 1) -
		@(Math.Min(CurrentPage * PageSize, TotalRecords))
		records of @TotalRecords total records
	</p>

	@* 
	[HCOM-DESIGN Notes]
	Main Bootstrap pagination control.

	The paginator always provides:
	    First | Previous | page range | Next | Last

	First and Previous are disabled on the first page.
	Next and Last are disabled on the last page.

	Navigation uses @onclick rather than normal browser navigation.
	@onclick:preventDefault prevents the "#" href from changing the browser
	location while retaining the Bootstrap page-link behavior.
	*@
	<nav class="mt-3">
		<ul class="pagination justify-content-center">

		@* Disable Previous and Go-To-First when on the first page *@
		@if (CurrentPage == 1)
		{
			<li class="page-item disabled">
				<a class="page-link" 
				   title="Go to First Page" 
				   href="#"
				   @onclick="() => GoToPage(1)"
				   @onclick:preventDefault >
					&laquo;
				</a>
			</li>

			<li class="page-item disabled">
				<a class="page-link" 
				   title="Go to Previous Page" 
				   href="#"
				   @onclick="() => GoToPage(CurrentPage - 1)"
				   @onclick:preventDefault >
					&lt;
				</a>
			</li>
		}
		else
		{
			<li class="page-item">
				<a class="page-link" 
				   title="Go to First Page" 
				   href="#"
				   @onclick="() => GoToPage(1)"
				   @onclick:preventDefault >
					&laquo;
				</a>
			</li>

			<li class="page-item">
				<a class="page-link" 
				   title="Go to Previous Page" 
				   href="#"
				   @onclick="() => GoToPage(CurrentPage - 1)"
				   @onclick:preventDefault >
					&lt;
				</a>
			</li>
		}

		@* 
		[HCOM-DESIGN Notes]
		The left ellipsis is determined by the distance between the beginning
		of the visible page range and the first page.

		The ellipsis is displayed only when the visible range is more than
		EllipsisThreshold pages away from the beginning of the complete
		page range.
		*@
		@* Left Ellipsis *@
		@if(TotalPages > EllipsisThreshold && (CurrentPage - PageRadius) > EllipsisThreshold)
		{
			<li class="page-item">
				<span class="page-link"> ... </span>
			</li>
		}

		@* 
		[HCOM-DESIGN Notes]
		The numbered page range is centered around CurrentPage using PageRadius.

		PageRadius determines how many pages on either side of CurrentPage
		are included in the visible range.

		The visible range is determined independently of the ellipsis.
		The ellipsis is a separate visual indication based on the distance
		of the visible range from the corresponding edge.

		This keeps the paginator compact when TotalPages becomes large while
		still allowing the user to navigate directly through the complete
		page range using the Go-To-Page selector.
		*@		
		@foreach (var page in Enumerable.Range(1, TotalPages))
		{
			@* Credit goes to Gemini for this distance-based range condition *@
			@if (Math.Abs(page - CurrentPage) <= PageRadius)
			{
				@if(page == CurrentPage)
				{
					<li class="page-item active">
						<a class="page-link"
						   href="#"
						   @onclick="() => GoToPage(page)"
						   @onclick:preventDefault > 
							@(page) 
						</a>
					</li>
				}
				else
				{
					<li class="page-item">
						<a class="page-link" 
						   href="#"
						   @onclick="() => GoToPage(page)"
						   @onclick:preventDefault > 
							@(page) 
						</a>
					</li>
				}
			}
		}

		@* 
		[HCOM-DESIGN Notes]
		The right ellipsis is determined by the distance between the end of
		the visible page range and the last page.

		The ellipsis is displayed only when the visible range is more than
		EllipsisThreshold pages away from the end of the complete page range.
		*@
		@* Right Ellipsis *@
		@if(TotalPages > EllipsisThreshold && TotalPages - (CurrentPage + PageRadius) > EllipsisThreshold)
		{
			<li class="page-item">
				<span class="page-link"> ... </span>
			</li>
		}

		@* Disable Next and Go-To-Last when on the last page *@
		@if (CurrentPage == TotalPages)
		{
			<li class="page-item disabled">
				<a class="page-link" 
				   title="Go to Next Page" 
				   href="#"
				   @onclick="() => GoToPage(CurrentPage + 1)" 
				   @onclick:preventDefault >
					&gt;
				</a>
			</li>

			<li class="page-item disabled">
				<a class="page-link" 
				   title="Go to Last Page" 
				   href="#"
				   @onclick="() => GoToPage(TotalPages)"
				   @onclick:preventDefault >
					&raquo;
				</a>
			</li>
		}
		else	
		{
			<li class="page-item">
				<a class="page-link" 
				   title="Go to Next Page" 
				   href="#"
				   @onclick="() => GoToPage(CurrentPage + 1)"
				   @onclick:preventDefault >
					&gt;
				</a>
			</li>

			<li class="page-item">
				<a class="page-link" 
				   title="Go to Last Page" 
				   href="#"
				   @onclick="() => GoToPage(TotalPages)"
				   @onclick:preventDefault >
					&raquo;
				</a>
			</li>
		}	
		</ul>
	</nav>

	@* 
	[HCOM-DESIGN Notes]
	Go-To-Page provides direct access to the complete page range.

	A select element is used instead of an input number so that:
	    - the complete valid page range is visible;
	    - the user cannot accidentally enter non-numeric page text;
	    - the selected page is maintained through GoToPageNumber.

	The Go button explicitly submits the selected page through the same
	GoToPage() method used by the numbered navigation links.
	*@
	<div class="d-flex align-items-center gap-4">
		<select class="form-select"
				id="goto-page"
				title="Go To Page"
				@bind="GoToPageNumber" >
			@foreach (var page in Enumerable.Range(1, TotalPages))
			{
				<option value="@(page)">@(page)</option>
			}
		</select>

		<input class="btn btn-primary"
			   type="submit"
			   value="Go"
			   @onclick="() => GoToPage(GoToPageNumber)"/>
	</div>
</div>

@code {
	@* 
	[HCOM-DESIGN Notes]
	These parameters represent the paging state owned by the parent component.
	The Paginator does not retrieve or manipulate data directly.
	*@
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalRecords { get; set; }
    [Parameter] public int PageSize { get; set; }

	@* Credit goes to Gemini for PageRadius parameter and its uses *@
	@* Push a Page range radius with a default value of 2 *@
	[Parameter] public int PageRadius { get; set; } = 2;

	@* 
	[HCOM-DESIGN Notes]
	PageLinkClicked delegates the actual page change to the parent component.
	This preserves separation of concerns between pagination UI and data loading.
	*@
	[Parameter] public EventCallback<int> PageLinkClicked { get; set; }

	@* 
	[HCOM-DESIGN Notes]
	GoToPageNumber stores the page selected by the Go-To-Page control.
	It is separate from CurrentPage because selecting a page does not change
	the active page until the Go button is invoked.
	*@
	private int GoToPageNumber { get; set; } = 1;

	@* 
	[HCOM-DESIGN Notes]
	EllipsisThreshold defines how far the visible page range must be from
	an edge before the corresponding ellipsis is displayed.

	The threshold is independent of PageRadius:
	    - PageRadius controls the size of the visible page range.
	    - EllipsisThreshold controls the edge distance required for an ellipsis.
	*@
	private const int EllipsisThreshold = 10;

	@* 
	[HCOM-DESIGN Notes]
	All navigation paths converge here.

	The clamp is intentional. CurrentPage can become stale when an operation
	such as changing PageSize or applying a search/filter reduces TotalPages.
	The page must therefore be normalized against the newly calculated
	TotalPages before the navigation event is propagated.

	GoToPageNumber is synchronized with the resulting page so the Go-To-Page
	selector reflects the current page after any navigation operation.
	*@
	private async Task GoToPage(int page) 
	{
		page = Math.Clamp(page, 1, TotalPages);
		GoToPageNumber = page;
		await PageLinkClicked.InvokeAsync(page);
	}
}

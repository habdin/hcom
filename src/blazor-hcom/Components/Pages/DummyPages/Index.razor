@*
   Index.razor - Main entry point for listing and managing Dummy entities.

   Features:
   - Interface toggling (Card/Table)
   - Searching functionality
   - Data loading from EF Core context
   - Placeholder methods for CRUD modal interaction

   To be implemented:
   - Sorting functionality for Table Interface.
   - Paging functionality for data
   - Modal display logic
 *@

@page "/dummies"
@using Microsoft.EntityFrameworkCore
@using blazor_hcom.Models

@namespace blazor_hcom.Components.Pages.DummyPages

@* Page title that appears in the browser title bar. *@
<AppTitle Title="Dummy Index" />

@* Inserts Heading and Toolbar for the Dummy2 Index Page *@
<div class="d-flex justify-content-between align-items-stretch pt-5 ">
	<h2 class="display-5 mt-4 flex-grow-1">List of Dummies</h2>

	<Toolbar SearchString="@SearchHandler" 
			 PageSize="@PageSize"
			 PageAmount="@PageAmountChangedHandler"
			 ViewToggled="@HandleToggleView" 
			 OnAddNew="HandleCreate" />
</div>

@* Inserts a line just below the Heading and Toolbar *@
<hr class="mb-3">

@* Inserts the actual data component for the Dummy2 App *@
<DataDisplay TEntity="Dummy"
			 Items="@Items"
			 IsLoading="@IsLoading"
			 IsTable="@ViewAsTable"
			 OnUpdateRecord="HandleUpdate"
			 OnDeleteRecord="HandleDelete"
			 OnDetailsRecord="HandleRead"
/>

<div class="pb-5">
	@if(@_totalPages > 1)
	{
		<Paginator TotalPages="@_totalPages"
			CurrentPage="@_currentPage"
			TotalRecords="@_totalRecords"
			PageSize="@PageSize"
			PageLinkClicked="PagerLinkClickHandler"
		/>
	}
</div>

@* Insert the Modal for the App. This is actually hidden and appears through events. *@
<Modal @ref="_myModalRef"
			TEntity="Dummy" Fading="true"
			Operation="@CrudOperation" Title="@ModalTitle"
			FormContent="@(MainForm(CrudOperation))"
			BtnSubmitText="@ModalSubmitBtnText"
			OnVisibilityChanged="@HandleModalVisibility"
			Size="Modal<Dummy>.ModalSize.ExtraLarge"
			Backdrop="Modal<Dummy>.ModalBackdrop.Static"
			BackDropClick="() => HandleBackdropClick<Dummy>(_myModalRef!)"
			OnSubmit="() => HandleSubmit(Item, CrudOperation)"
			OnClose="() => ModalHideAsync<Dummy>(_myModalRef!)"
/>

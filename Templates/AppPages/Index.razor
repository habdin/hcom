@*
   Index.razor - Main entry point for listing and managing {{EntityPlural}}.

   Features:
   - Interface toggling (Card/Table)
   - Searching functionality
   - Data loading from EF Core context
   - CRUD operations via a reusable Modal component.

   This file is responsible only for composing the UI.
   The implementation details are delegated to the corresponding
   partial class files.
*@

@* Change the route according the target app *@
@page "/{{Route}}"

@using Microsoft.EntityFrameworkCore

@* Change Model namespace for the target App.*@
@* @using namespace *@

@* Change Page namespace for the target App. *@
@* @namespace {{PageNamespace}} *@

@* Chagne The page title. This appears in the browser title bar. *@
@* <AppTitle Title="{{Entity}} Index" /> *@

@* Change the Heading and Toolbar for the App Index Page *@
<div class="d-flex justify-content-between pt-5 ">
	<h2 class="display-5 mt-4 flex-grow-1">List of {{EntityPlural}}</h2>

	@*<Toolbar SearchString="@SearchHandler"
			 ViewToggled="@HandleToggleView"
			 OnAddNew="HandleCreate" /> *@
</div>

@* Insert a line just below the Heading and Toolbar *@
<hr class="mb-3">

@* Insert the actual data component for the App *@
@* <DataDisplay TEntity="{{Entity}}"
			 Items="@Items"
			 IsLoading="@IsLoading"
			 IsTable="@ViewAsTable"
			 OnUpdateRecord="HandleUpdate"
			 OnDeleteRecord="HandleDelete"
			 OnDetailsRecord="HandleRead"
/> *@

@* Insert the Modal for the App. This is actually hidden and appears through events. *@
@* <Modal @ref="_myModalRef"
	   TEntity="{{Entity}}"
	   Fading="true"
	   Operation="@CrudOperation"
	   Title="@ModalTitle"
	   FormContent="@(MainForm(CrudOperation))"
	   BtnSubmitText="@ModalSubmitBtnText"
	   OnVisibilityChanged="@HandleModalVisibility"
	   Size="Modal<{{Entity}}>.ModalSize.ExtraLarge"
	   Backdrop="Modal<{{Entity}}>.ModalBackdrop.Static"
	   BackDropClick="HandleBackdropClick"
	   OnSubmit="(() => HandleSubmit(Item, CrudOperation))"
	   OnClose="ModalHideAsync"
/>*@
